rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todas podem ler a escala. A gravação aceita só o formato do app.
    match /rodizio/escala {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['json', 'atualizado', 'por'])
                   && request.resource.data.json is string
                   && request.resource.data.json.size() < 500000;
    }
  }
}
